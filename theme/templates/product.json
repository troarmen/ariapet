                "text_guia_medidas": {
                  "type": "text",
                  "settings": {
                    "text": "<p><strong>Coleira</strong></p><ul><li>P — pescoço de 28 a 38 cm, tira de 2,0 cm</li><li>M — pescoço de 34 a 50 cm, tira de 2,0 cm</li><li>G — pescoço de 42 a 62 cm, tira de 2,5 cm</li></ul><p><strong>Peitoral</strong></p><ul><li>P — pescoço de 32 a 42 cm, tórax de 38 a 58 cm, tira de 2,0 cm</li><li>M — pescoço de 40 a 50 cm, tórax de 55 a 75 cm, tira de 2,0 cm</li><li>G — pescoço de 48 a 62 cm, tórax de 70 a 85 cm, tira de 2,5 cm</li></ul><p><strong>Medida fixa</strong></p><ul><li>Guia: 230 cm de comprimento por 2,0 cm de largura</li><li>Porta saquinho: 8 cm por 5 cm</li></ul>",
